% 合适的 ^ 与 ~
\newcommand*{\caret}{%
  \begingroup
    \fontencoding{T1}%
    \fontfamily{pcr}% Courier
    \selectfont
    \string^%
  \endgroup
}
\renewcommand*{\tilde}{\raise.17ex\hbox{$\scriptstyle\mathtt{\sim}$}}
% 在 \begin{document} 时再次重定义,确保覆盖 amsmath 的 \tilde(文本模式可用的波浪号)
\AtBeginDocument{\renewcommand*{\tilde}{\raise.17ex\hbox{$\scriptstyle\mathtt{\sim}$}}}
% 源码中的 ~(独立命令,避免与其它宏包的 \tilde 冲突)
\newcommand*{\lsttilde}{\raise.17ex\hbox{$\scriptstyle\mathtt{\sim}$}}

% 更粗的 {},与 () 更易区分
% 会让 pdf 编译时间增加 5-10%,但应该值得?
\newcommand*{\nicelbrace}{%
  \begingroup
    \fontencoding{T1}%
    \fontfamily{pcr}% Courier
    \selectfont
	\scalebox{1.5}[1]{\color{black!80}{\{}}%
  \endgroup
}
\newcommand*{\nicerbrace}{%
  \begingroup
    \fontencoding{T1}%
    \fontfamily{pcr}% Courier
    \selectfont
	\scalebox{1.5}[1]{\color{black!80}{\}}}%
  \endgroup
}

