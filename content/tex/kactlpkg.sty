% 在每页顶部列出本页收录的源文件。为了记录这些信息,我们使用 eTeX marks。
% (不能直接把数据追加到页眉,因为 TeX 异步输出页面,使用 multicol 时尤其明显。)
% 没有命令能取得一页上设置的全部 mark,所以只取最后一个,
% 并收录到它为止所有尚未收录的文件。多数情况下 \splitbotmark 会给出正确的
% mark,少数情况下会出错,我们就退回 \botmark 尽力而为。
% 另外,LaTeX 的字符串处理很糟糕,所以实际处理都放在 Python 里做,
% 全局状态存放在 header.tmp。
\newmarks\hdrmark
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}
\headheight 25pt
\lhead{\@unishort}
\chead{\immediate\write18{python3 content/tex/preprocessor.py --print-header "\splitbotmarks\hdrmark|\botmarks\hdrmark" -o \@builddir/header2.tmp}\immediate\input{\@builddir/header2.tmp}}
\rhead{\thepage}
%\lhead{}\chead{\thepage}\rhead{}
\lfoot{}\cfoot{}\rfoot{}
\fancyheadoffset{0pt}
\fancyfootoffset{0pt}
\setlength\headsep{5pt}

\renewcommand\chapter{
	\global\@topnum\z@
	\secdef
	\@chapter
	\@schapter
}

% 不把附录加入目录
% 目前这会使附录章节的局部目录部分失效
\newboolean{appendixmode}
\setboolean{appendixmode}{false}
\let\Oldaddtoc\addcontentsline
\renewcommand{\addcontentsline}[3]{
	\ifthenelse{
		\boolean{appendixmode}\and\equal{#1}{toc}
	}{}{\Oldaddtoc{#1}{#2}{#3}}
}

% 重定义 appendix
\renewcommand\appendix{
	% 把章节计数器改为 A,B,C,...
	\setcounter{tocdepth}{8}
	\setcounter{chapter}{0}
	\def\thechapter{\Alph{chapter}}
	% 切换到上面定义的 appendixmode(禁用目录条目)
	\setboolean{appendixmode}{true}
	\clearpage
}

\def\@makechapterhead#1{

	\parindent \z@ \raggedright \normalfont
		\interlinepenalty\@M
	{\underline{\huge \bfseries #1} }
	\ifnum \c@secnumdepth >\m@ne
		{\huge\bfseries (\thechapter) \par\nobreak }
	\fi
	\startcontents[chapters]
}

\renewcommand\section{\@startsection {section}{1}{\z@}%
                                   {-0.5ex \@plus -1ex \@minus -.2ex}%
                                   {.4ex}%
                                   {\normalfont\LARGE\bfseries}}

\renewcommand\subsection{\@startsection{subsection}{2}{\z@}
	{1ex\@plus -1ex \@minus -.3ex}
	{.2ex}
	{\normalfont\large\bfseries}}

\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}
	{1ex\@plus -1ex \@minus -.3ex}
	{1ex \@plus .2ex}
	{\normalfont\large\bfseries}}

